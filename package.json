{
  "name": "emulate-monorepo",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "emulate:all": "bun scripts/emulate-all.ts",
    "test": "turbo run test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "type-check": "turbo run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@emulators/apple": "0.12.2",
    "@emulators/aws": "0.12.2",
    "@emulators/clerk": "0.12.2",
    "@emulators/core": "0.12.2",
    "@emulators/github": "0.12.2",
    "@emulators/google": "0.12.2",
    "@emulators/microsoft": "0.12.2",
    "@emulators/mongoatlas": "0.12.2",
    "@emulators/okta": "0.12.2",
    "@emulators/resend": "0.12.2",
    "@emulators/slack": "0.12.2",
    "@emulators/stripe": "0.12.2",
    "@emulators/vercel": "0.12.2",
    "@pleaseai/emulate": "workspace:*",
    "@pleaseai/eslint-config": "^0.1.0",
    "@types/bun": "^1.4.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "emulate": "0.12.2",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
