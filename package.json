{
  "name": "emulate-monorepo",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "emulate:all": "bun scripts/emulate-all.ts",
    "test": "turbo run test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "type-check": "turbo run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@emulators/apple": "0.9.0",
    "@emulators/aws": "0.9.0",
    "@emulators/clerk": "0.9.0",
    "@emulators/core": "0.10.0",
    "@emulators/github": "0.9.0",
    "@emulators/google": "0.9.0",
    "@emulators/microsoft": "0.9.0",
    "@emulators/mongoatlas": "0.9.0",
    "@emulators/okta": "0.9.0",
    "@emulators/resend": "0.9.0",
    "@emulators/slack": "0.9.0",
    "@emulators/stripe": "0.9.0",
    "@emulators/vercel": "0.9.0",
    "@pleaseai/emulate": "workspace:*",
    "@pleaseai/eslint-config": "^0.0.4",
    "@types/bun": "^1.3.5",
    "@typescript/native-preview": "7.0.0-dev.20260604.1",
    "emulate": "0.9.0",
    "eslint": "^10.4.1",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "turbo": "^2",
    "typescript": "^6",
    "yaml": "^2"
  }
}
