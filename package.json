{
  "name": "emulate-monorepo",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "emulate:all": "bun scripts/emulate-all.ts",
    "test": "turbo run test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "type-check": "turbo run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@emulators/apple": "0.13.0",
    "@emulators/aws": "0.13.0",
    "@emulators/clerk": "0.13.0",
    "@emulators/core": "0.12.3",
    "@emulators/github": "0.13.0",
    "@emulators/google": "0.13.0",
    "@emulators/microsoft": "0.13.0",
    "@emulators/mongoatlas": "0.13.0",
    "@emulators/okta": "0.13.0",
    "@emulators/resend": "0.13.0",
    "@emulators/slack": "0.13.0",
    "@emulators/stripe": "0.13.0",
    "@emulators/vercel": "0.13.0",
    "@pleaseai/emulate": "workspace:*",
    "@pleaseai/eslint-config": "^0.1.0",
    "@types/bun": "^1.4.4",
    "emulate": "0.13.0",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "katex": "^0.18.2"
  }
}
